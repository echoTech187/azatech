# PostgreSQL
POSTGRES_USER=azatech
POSTGRES_PASSWORD=azatech_secret
POSTGRES_DB=azatech_shop
DATABASE_URL=postgresql://azatech:azatech_secret@localhost:5432/azatech_shop?schema=public

# Redis (Cache & Rate Limit)
REDIS_URL=redis://localhost:6379

# RabbitMQ (Async Job Queue & DLX)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@azatech.id
ADMIN_ALERT_EMAIL=admin@azatech.id

# Backend API Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=azatech_super_secret_access_key_2026
JWT_REFRESH_SECRET=azatech_super_secret_refresh_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000/api