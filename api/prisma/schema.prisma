generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  cashier
}


enum Gender {
  Pria
  Wanita
}


enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  INITIAL
  ORDER_OUT
  CANCEL_RESTORE
  ADJUSTMENT
}


enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}


model User {
  id              BigInt           @id @default(autoincrement())
  name            String           @db.VarChar(100)
  email           String           @unique @db.VarChar(150)
  password        String           @db.VarChar(255)
  role            Role
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  orders          Order[]
  stock_movements StockMovement[]
  refresh_tokens  RefreshToken[]


  @@map("users")
}


model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         BigInt
  token_hash      String    @unique @db.VarChar(64)
  replaced_by_id  String?   @db.Uuid
  revoked_at      DateTime?
  expires_at      DateTime
  created_at      DateTime  @default(now())
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)


  @@index([user_id], name: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}


model Product {
  id                  BigInt          @id @default(autoincrement())
  product_code        String          @unique @db.VarChar(50)
  product_name        String          @db.VarChar(200)
  stock               Int
  price               Decimal         @db.Decimal(12, 2)
  low_stock_threshold Int             @default(5)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  deleted_at          DateTime?
  order_items         OrderItem[]
  stock_movements     StockMovement[]


  @@index([deleted_at, product_name], name: "idx_products_active_name")
  @@map("products")
}


model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  customer_name    String    @db.VarChar(150)
  customer_address String    @db.Text
  gender           Gender
  birth_date       DateTime  @db.Date
  phone            String?   @db.VarChar(30)
  email            String?   @db.VarChar(150)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?
  orders           Order[]


  @@index([deleted_at, customer_name], name: "idx_customers_active_name")
  @@map("customers")
}


model Order {
  id              BigInt      @id @default(autoincrement())
  order_number    String      @unique @db.VarChar(30)
  customer_id     String      @db.Uuid
  created_by      BigInt
  status          OrderStatus @default(PENDING)
  total_amount    Decimal     @db.Decimal(14, 2)
  paid_at         DateTime?
  shipped_at      DateTime?
  completed_at    DateTime?
  cancelled_at    DateTime?
  cancel_reason   String?     @db.VarChar(255)
  invoice_sent_at DateTime?
  order_date      DateTime    @default(now())
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt


  customer        Customer    @relation(fields: [customer_id], references: [id])
  creator         User        @relation(fields: [created_by], references: [id])
  items           OrderItem[]


  @@index([order_date, status], name: "idx_orders_date_status")
  @@index([customer_id, order_date(sort: Desc)], name: "idx_orders_customer_date")
  @@map("orders")
}


model OrderItem {
  id         BigInt  @id @default(autoincrement())
  order_id   BigInt
  product_id BigInt
  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(14, 2)


  order      Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [product_id], references: [id])


  @@index([order_id], name: "idx_order_items_order_id")
  @@index([product_id, order_id], name: "idx_order_items_product_order")
  @@map("order_items")
}


model StockMovement {
  id              BigInt            @id @default(autoincrement())
  product_id      BigInt
  type            StockMovementType
  quantity_change Int
  stock_after     Int
  reference_type  String?           @db.VarChar(50)
  reference_id    String?           @db.VarChar(50)
  note            String?           @db.VarChar(255)
  created_by      BigInt
  created_at      DateTime          @default(now())


  product         Product           @relation(fields: [product_id], references: [id])
  creator         User              @relation(fields: [created_by], references: [id])


  @@index([product_id, created_at(sort: Desc)], name: "idx_stock_movements_product_date")
  @@map("stock_movements")
}


model IdempotencyKey {
  key           String            @id @db.Uuid
  user_id       BigInt
  request_hash  String            @db.VarChar(64)
  status        IdempotencyStatus @default(PROCESSING)
  response_code Int?
  response_body Json?
  locked_until  DateTime
  expires_at    DateTime
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt


  @@index([expires_at], name: "idx_idempotency_expires")
  @@map("idempotency_keys")
}
