# DATABASE CONFIG
DATABASE_URL="postgresql://postgres:password@localhost:5432/azatech_shop?schema=public"

# APP CONFIG
PORT=5000
NODE_ENV="development"

# JWT CONFIG
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# MESSAGE BROKER & CACHE CONFIG
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://localhost:5672"

# SMTP / EMAIL CONFIG
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@azatech.com"